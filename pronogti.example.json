		"secondaries": {}
	},
	"session": {
		"enabled": true,
		"cookie_name": "_pronogti_s",
		"kiosk_cookie_name": "_pronogti_kiosk",
		"kiosk_cookie_max_age": 34560000,
		"cookie_domain": "",
