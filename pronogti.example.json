{
	"baseURL": "http://localhost:3000",
	"httpServer": "127.0.0.1:59000",
	"logLevel": "info",
	"logFormat": "text",
	"middlewareTimeout": 60000,
	"clientQueryTimeout": 10000,
	"httpReadTimeout": "15s",
	"httpWriteTimeout": "65s",
	"httpIdleTimeout": "60s",
	"appShutdownTimeout": 10,
	"cacheTime": 10800000000000,
